# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for local dev; use PostgreSQL in Docker)
DATABASE_URL=sqlite:///db.sqlite3

# File storage
FILE_ENCRYPTION_KEY=change-me-32-byte-base64-key-here==
MAX_UPLOAD_SIZE_MB=25
MEDIA_ROOT=media
STORAGE_ROOT=storage

# JWT (no expiry per user stories — very long lifetime)
JWT_ACCESS_TOKEN_LIFETIME_DAYS=3650

# ML scan
SCAN_CONFIDENCE_THRESHOLD=0.7

# Rate limiting
LOGIN_RATE_LIMIT=5

# Firebase Auth (Project settings → General → Your apps → Web)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
